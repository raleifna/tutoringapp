FRONTEND_URL=http://localhost:8443
CORS_ORIGIN=http://localhost:3000,http://localhost:8443
EMAIL_VERIFICATION_REQUIRED=true
# Local development defaults. The startup script will create `.env` from this
# file on first run if it does not already exist.
JWT_SECRET=local-dev-jwt-secret-change-me
JWT_REFRESH_SECRET=local-dev-jwt-refresh-secret-change-me
EMAIL_FROM=TutorConnect <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:8443
# Optional for local payment testing. Leave blank unless you are testing Stripe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional AI reply helper for chat. Leave key blank to use mock replies.
AI_REPLY_PROVIDER=openai
AI_REPLY_MODE=mock
OPENAI_API_KEY=
OPENAI_REPLY_MODE=mock
OPENAI_REPLY_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_REPLY_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_REPLY_MODEL=claude-3-5-haiku-latest
POSTGRES_HOST_PORT=15432
BACKEND_HOST_PORT=5050
FRONTEND_HOST_PORT=3000
NGINX_HOST_PORT=8443
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
