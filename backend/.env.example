DATABASE_URL=postgresql://tutorconnect:tutorconnect_pass@localhost:15432/tutorconnect?schema=public
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8443
CORS_ORIGIN=http://localhost:3000,http://localhost:8443
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_FROM=TutorConnect <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional AI reply helper for chat. Leave key blank to use mock replies.
AI_REPLY_PROVIDER=openai
AI_REPLY_MODE=mock
OPENAI_API_KEY=
OPENAI_REPLY_MODE=mock
OPENAI_REPLY_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_REPLY_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_REPLY_MODEL=claude-3-5-haiku-latest
