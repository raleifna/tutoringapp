// Prisma Schema for TutorConnect App
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  LEARNER
  TUTOR
  ADMIN
  SYSTEM_ADMIN
}

enum ProfileStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

enum RecurringType {
  ONE_OFF
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum MeetingTool {
  GOOGLE_MEET
  ZOOM
  MICROSOFT_TEAMS
  SKYPE
  OTHER
}

enum SessionType {
  ONLINE
  IN_PERSON
  HYBRID
}

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ==================== USER ====================

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  password      String
  role          Role          @default(LEARNER)
  status        ProfileStatus @default(ACTIVE)
  firstName     String
  lastName      String
  avatar        String?
  phone         String?
  dateOfBirth   DateTime?
  bio           String?
  preferredLang String        @default("en")
  timezone      String        @default("UTC")
  isEmailVerified          Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpiry  DateTime?
  preferredMeetingTool     MeetingTool?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastLoginAt   DateTime?

  // Relations
  learnerProfile  LearnerProfile?
  tutorProfile    TutorProfile?
  bookingsAsLearner Booking[]      @relation("LearnerBookings")
  subscription    Subscription?
  payments        Payment[]
  refreshTokens   RefreshToken[]
  adminActions    AdminAction[]    @relation("AdminActioner")
  adminTargeted   AdminAction[]    @relation("AdminTarget")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

// ==================== PROFILES ====================

model LearnerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  gradeLevel      String?
  learningGoals   String?
  subjects        String[] // subjects they want to learn
  preferredStyle  String?  // visual, auditory, kinesthetic
  // Parent / Guardian fields (for minors)
  isMinor         Boolean  @default(false)
  parentName      String?
  parentEmail     String?
  parentPhone     String?
  parentRelationship String? // mother, father, guardian, etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learner_profiles")
}

model TutorProfile {
  id                String        @id @default(uuid())
  userId            String        @unique
  status            ProfileStatus @default(PENDING)
  headline          String?
  hourlyRate        Decimal       @db.Decimal(10, 2) @default(0)
  currency          String        @default("AUD")
  yearsExperience   Int           @default(0)
  education         Json[]        // [{institution, degree, field, year}]
  certifications    Json[]        // [{name, issuer, year, url}]
  languages         String[]      @default(["English"])
  sessionTypes      SessionType[] @default([ONLINE])
  location          String?
  latitude          Decimal?      @db.Decimal(10, 8)
  longitude         Decimal?      @db.Decimal(11, 8)
  rating            Decimal       @db.Decimal(3, 2) @default(0)
  totalReviews      Int           @default(0)
  totalSessions     Int           @default(0)
  isVerified        Boolean       @default(false)
  verifiedAt        DateTime?
  responseTime      Int?          // avg response time in minutes
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Session duration options (in minutes)
  sessionDurations  Int[]           @default([60]) // e.g. [30, 60, 90]
  preferredMeetingTool MeetingTool?

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects     TutorSubject[]
  availability TutorAvailability[]
  bookings     Booking[]         @relation("TutorBookings")

  @@index([status])
  @@index([rating])
  @@index([hourlyRate])
  @@map("tutor_profiles")
}

model Subject {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now())

  tutors TutorSubject[]

  @@index([category])
  @@map("subjects")
}

model TutorSubject {
  id          String @id @default(uuid())
  tutorId     String
  subjectId   String
  level       String
  description String?

  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tutorId, subjectId])
  @@map("tutor_subjects")
}

model TutorAvailability {
  id        String   @id @default(uuid())
  tutorId   String
  dayOfWeek Int
  startTime String
  endTime   String
  timezone  String   @default("UTC")

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@map("tutor_availability")
}

// ==================== BOOKINGS ====================

model Booking {
  id                 String        @id @default(uuid())
  learnerId          String
  tutorId            String
  subject            String
  status             BookingStatus @default(PENDING)
  sessionType        SessionType   @default(ONLINE)
  scheduledAt        DateTime
  duration           Int
  hourlyRate         Decimal       @db.Decimal(10, 2)
  totalAmount        Decimal       @db.Decimal(10, 2)
  currency           String        @default("AUD")
  notes              String?
  meetingLink        String?
  meetingTool        MeetingTool?
  address            String?
  cancellationReason String?
  declineReason      String?
  rescheduleNote     String?
  proposedTime       DateTime?
  recurringType      RecurringType @default(ONE_OFF)
  recurringGroupId   String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  completedAt        DateTime?

  learner       User                   @relation("LearnerBookings", fields: [learnerId], references: [id])
  tutorProfile  TutorProfile           @relation("TutorBookings", fields: [tutorId], references: [id])
  payment       Payment?
  statusHistory BookingStatusHistory[]

  @@index([learnerId])
  @@index([tutorId])
  @@index([status])
  @@index([scheduledAt])
  @@map("bookings")
}

model BookingStatusHistory {
  id        String        @id @default(uuid())
  bookingId String
  status    BookingStatus
  reason    String?
  createdAt DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_status_history")
}

// ==================== PAYMENTS & SUBSCRIPTIONS ====================

model Subscription {
  id               String             @id @default(uuid())
  userId           String             @unique
  plan             SubscriptionPlan   @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  stripeCustomerId String?
  stripePriceId    String?
  stripeSubId      String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean          @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Payment {
  id              String        @id @default(uuid())
  userId          String
  bookingId       String?       @unique
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("AUD")
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?
  stripeSessionId String?
  description     String?
  // Platform fee / commission
  platformFeePercent Decimal?   @db.Decimal(5, 2)  // e.g. 15.00 for 15%
  platformFeeAmount  Decimal?   @db.Decimal(10, 2) // actual $ amount kept by platform
  tutorPayoutAmount  Decimal?   @db.Decimal(10, 2) // amount sent to tutor
  payoutStatus       String?    @default("PENDING")  // PENDING, PAID, FAILED
  payoutAt           DateTime?
  refundAmount    Decimal?      @db.Decimal(10, 2)
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([userId])
  @@map("payments")
}

// ==================== ADMIN ====================

model AdminAction {
  id          String   @id @default(uuid())
  adminId     String
  targetUserId String?
  action      String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  admin      User  @relation("AdminActioner", fields: [adminId], references: [id])
  targetUser User? @relation("AdminTarget", fields: [targetUserId], references: [id])

  @@map("admin_actions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("refresh_tokens")
}

// ==================== NOTIFICATION ====================
model Notification {
  id String @id @default(uuid())
  userId String
  type String @default("system") // system, message, booking, payment
  title String
  message String
  timestamp DateTime @default(now())
  read Boolean @default(false)
  link String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}



