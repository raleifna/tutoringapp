generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  TUTOR
  ADMIN
  SYSTEM_ADMIN
}

enum ProfileStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  password      String
  role          Role          @default(LEARNER)
  status        ProfileStatus @default(ACTIVE)
  firstName     String
  lastName      String
  avatar        String?
  phone         String?
  dateOfBirth   DateTime?
  bio           String?
  preferredLang String        @default("en")
  timezone      String        @default("UTC")
  isEmailVerified          Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpiry  DateTime?
  preferredMeetingTool     MeetingTool?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastLoginAt   DateTime?

  // Relations
  learnerProfile  LearnerProfile?
  tutorProfile    TutorProfile?
  bookingsAsLearner Booking[]      @relation("LearnerBookings")
  subscription    Subscription?
  payments        Payment[]
  refreshTokens   RefreshToken[]
  adminActions    AdminAction[]    @relation("AdminActioner")
  adminTargeted   AdminAction[]    @relation("AdminTarget")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("refresh_tokens")
}


model Subject {
  id          String   @id @default(uuid())
  name        String   @unique // subject name
  category    String
  description String?
  createdAt   DateTime @default(now())
  tutors TutorSubject[]
  @@map("subjects")
}

model TutorProfile {
  id                String        @id @default(uuid())
  userId            String        @unique
  // profile status
  status            ProfileStatus @default(PENDING)

  headline          String?
  hourlyRate        Decimal       @db.Decimal(10, 2) @default(0)
  currency          String        @default("AUD") // default for now
  yearsExperience   Int           @default(0)
  // tutor education history
  education         Json[]        // [{institution, degree, field, year}]
  certifications    Json[]        // certificates etc
  languages         String[]      @default(["English"]) // can add more later
  sessionTypes      SessionType[] @default([ONLINE])
  location          String?

  // map related
  latitude          Decimal?      @db.Decimal(10, 8)
  longitude         Decimal?      @db.Decimal(11, 8)

  rating            Decimal       @db.Decimal(3, 2) @default(0)
  totalReviews      Int           @default(0)
  totalSessions     Int           @default(0)
  isVerified        Boolean       @default(false)
  verifiedAt        DateTime?
  responseTime      Int?          // minutes
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // allowed session durations
  sessionDurations  Int[]           @default([60]) // e.g 30 / 60 / 90
  preferredMeetingTool MeetingTool?
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects     TutorSubject[]
  availability TutorAvailability[]
  bookings     Booking[]         @relation("TutorBookings")

  @@map("tutor_profiles")
}


model TutorSubject {
  id           String @id @default(uuid())
  tutorId      String
  subjectId    String
  // beginner / intermediate / advanced / all
  level        String
  description  String?
  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@unique([tutorId, subjectId]) // avoid duplicates
  @@map("tutor_subjects")
}