generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  TUTOR
  ADMIN
  SYSTEM_ADMIN
}

enum ProfileStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

enum RecurringType {
  ONE_OFF
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum MeetingTool {
  GOOGLE_MEET
  ZOOM
  MICROSOFT_TEAMS
  SKYPE
  OTHER
}

enum SessionType {
  ONLINE
  IN_PERSON
  HYBRID
}

model User {
  id                       String        @id @default(uuid())
  email                    String        @unique
  password                 String
  role                     Role          @default(LEARNER)
  status                   ProfileStatus @default(ACTIVE)
  firstName                String
  lastName                 String
  avatar                   String?
  phone                    String?
  dateOfBirth              DateTime?
  bio                      String?
  preferredLang            String        @default("en")
  timezone                 String        @default("UTC")
  isEmailVerified          Boolean       @default(false)
  emailVerificationToken   String?       @unique
  emailVerificationExpiry  DateTime?
  preferredMeetingTool     MeetingTool?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  lastLoginAt              DateTime?

  learnerProfile     LearnerProfile?
  tutorProfile       TutorProfile?
  bookingsAsLearner  Booking[]      @relation("LearnerBookings")
  refreshTokens      RefreshToken[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model LearnerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  gradeLevel         String?
  learningGoals      String?
  subjects           String[]
  preferredStyle     String?
  isMinor            Boolean  @default(false)
  parentName         String?
  parentEmail        String?
  parentPhone        String?
  parentRelationship String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learner_profiles")
}

model TutorProfile {
  id                   String        @id @default(uuid())
  userId               String        @unique
  status               ProfileStatus @default(PENDING)
  headline             String?
  hourlyRate           Decimal       @db.Decimal(10, 2) @default(0)
  currency             String        @default("AUD")
  yearsExperience      Int           @default(0)
  education            Json[]
  certifications       Json[]
  languages            String[]      @default(["English"])
  sessionTypes         SessionType[] @default([ONLINE])
  location             String?
  latitude             Decimal?      @db.Decimal(10, 8)
  longitude            Decimal?      @db.Decimal(11, 8)
  rating               Decimal       @db.Decimal(3, 2) @default(0)
  totalReviews         Int           @default(0)
  totalSessions        Int           @default(0)
  isVerified           Boolean       @default(false)
  verifiedAt           DateTime?
  responseTime         Int?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  sessionDurations     Int[]         @default([60])
  preferredMeetingTool MeetingTool?

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects     TutorSubject[]
  availability TutorAvailability[]
  bookings     Booking[]          @relation("TutorBookings")

  @@index([status])
  @@index([rating])
  @@index([hourlyRate])
  @@map("tutor_profiles")
}

model Subject {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now())

  tutors TutorSubject[]

  @@index([category])
  @@map("subjects")
}

model TutorSubject {
  id          String @id @default(uuid())
  tutorId     String
  subjectId   String
  level       String
  description String?

  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tutorId, subjectId])
  @@map("tutor_subjects")
}

model TutorAvailability {
  id        String   @id @default(uuid())
  tutorId   String
  dayOfWeek Int
  startTime String
  endTime   String
  timezone  String   @default("UTC")

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@map("tutor_availability")
}

model Booking {
  id                 String        @id @default(uuid())
  learnerId          String
  tutorId            String
  subject            String
  status             BookingStatus @default(PENDING)
  sessionType        SessionType   @default(ONLINE)
  scheduledAt        DateTime
  duration           Int
  hourlyRate         Decimal       @db.Decimal(10, 2)
  totalAmount        Decimal       @db.Decimal(10, 2)
  currency           String        @default("AUD")
  notes              String?
  meetingLink        String?
  meetingTool        MeetingTool?
  address            String?
  cancellationReason String?
  declineReason      String?
  rescheduleNote     String?
  proposedTime       DateTime?
  recurringType      RecurringType @default(ONE_OFF)
  recurringGroupId   String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  completedAt        DateTime?

  learner       User                   @relation("LearnerBookings", fields: [learnerId], references: [id])
  tutorProfile  TutorProfile           @relation("TutorBookings", fields: [tutorId], references: [id])
  statusHistory BookingStatusHistory[]

  @@index([learnerId])
  @@index([tutorId])
  @@index([status])
  @@index([scheduledAt])
  @@map("bookings")
}

model BookingStatusHistory {
  id        String        @id @default(uuid())
  bookingId String
  status    BookingStatus
  reason    String?
  createdAt DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_status_history")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("refresh_tokens")
}
