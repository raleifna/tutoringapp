{
  "name": "tutorconnect-backend",
  "version": "1.0.0",
  "description": "TutorConnect backend service",
  "packageManager": "pnpm@10.15.0",
  "main": "server.js",
  "scripts": {
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "postinstall": "prisma generate",
    "start": "pnpm run db:push && node server.js",
    "dev": "pnpm run db:push && node --watch server.js"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.4",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.3.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "1.4.5-lts.2",
    "nodemailer": "^8.0.5",
    "socket.io": "^4.8.1",
    "stripe": "^22.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "prisma": "^6.6.0"
  }
}
